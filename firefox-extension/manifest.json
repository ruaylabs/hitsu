{
  "manifest_version": 3,
  "name": "Hitsu Password Manager",
  "version": "0.2.0",
  "description": "Fill login credentials from the unlocked Hitsu desktop app.",
  "permissions": ["activeTab", "nativeMessaging", "scripting"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Hitsu",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hitsu@ruaylabs.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
